# Copy to .env.local and fill in. Both values are PUBLIC by design (they ship in the browser bundle);
# Row Level Security in the database is what protects the data.
# NEVER put the secret key or the legacy service_role key here.
# Leave both empty to run the app in demo mode with mock data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
